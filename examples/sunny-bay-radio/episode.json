 "lines": [
  {
   "who": "D",
   "emotion": "excited",
   "text": "Good morning, Sunny Bay! You're listening to Wave ninety-nine point nine, where the traffic is terrible and the music is worse!",
   "gesture": "explain",
   "cam": "wide",
   "set": "studio"
  },
  {
   "who": "A",
   "emotion": "cheer",
   "text": "And I'm Alfie, the intern! I make the coffee, and I'm legally allowed to touch exactly one button!",
   "gesture": "cheer",
   "cam": "two:D:A"
  },
  {
   "who": "D",
   "emotion": "worried",
   "text": "Alfie, which button?",
   "gesture": "point",
   "cam": "close:D"
  },
  {
   "who": "A",
   "emotion": "worried",
   "text": "I forgot. Please don't ask me again.",
   "gesture": "shrug",
   "cam": "close:A"
  },
  {
   "who": "D",
   "emotion": "excited",
   "text": "Our first guest saw a seagull steal a whole pizza. Brenda, you're on the air!",
   "gesture": "explain",
   "cam": "wide"
  },
  {
   "who": "B",
   "emotion": "panic",
   "text": "It was a WHOLE pizza, Rick! He flew off with it, and then he came BACK for the garlic bread!",
   "gesture": "panic",
   "cam": "high",
   "react": {
    "D": "listen",
    "A": "listen"
   }
  },
  {
   "who": "D",
   "emotion": "angry",
   "text": "The audacity! Alfie, put that on the news ticker!",
   "gesture": "angry",
   "cam": "two:D:B"
  },
  {
   "who": "A",
   "emotion": "sad",
   "text": "I would, but the ticker is just a hamster on a wheel.",
   "gesture": "shrug",
   "cam": "close:A"
  },
  {
   "who": "D",
   "emotion": "worried",
   "text": "Then make sure it's a fast hamster. Brenda, did you get a licence plate?",
   "gesture": "point",
   "cam": "high"
  },
  {
   "who": "B",
   "emotion": "angry",
   "text": "Rick. He's a seagull.",
   "gesture": "angry",
   "cam": "close:B"
  },
  {
   "who": "D",
   "emotion": "sly",
   "text": "A lot of criminals hide behind that excuse.",
   "gesture": "nod",
   "cam": "close:D"
  },
  {
   "who": "D",
   "emotion": "excited",
   "text": "This segment is sponsored by Gator Dental. Because every great smile deserves a snappy bite!",
   "gesture": "explain",
   "cam": "wide"
  },
  {
   "who": "A",
   "emotion": "cheer",
   "text": "Gator Dental: if you can't afford your teeth, we'll find you a friend who can!",
   "gesture": "cheer",
   "cam": "two:D:A",
   "react": {
    "B": "cheer"
   }
  },
  {
   "who": "D",
   "emotion": "excited",
   "text": "Coming up after the break, a man who claims his dog can file taxes. Stay tuned, Sunny Bay!",
   "gesture": "explain",
   "cam": "wide"
  },
  {
   "who": "A",
   "emotion": "worried",
   "text": "And remember: if you see a seagull, don't make eye contact!",
   "gesture": "panic",
   "cam": "two:A:B",
   "react": {
    "B": "panic",
    "D": "cheer"
   }
  }
 ],
